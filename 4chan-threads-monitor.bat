@echo off
setlocal EnableDelayedExpansion
cd /d "%~dp0"
title 4chan Thread Monitor v2.0

set "LIST=threads_4chan.txt"
set "LOG=log_4chan.txt"
set "NEW_BOX=new_4chan.txt"
set "PRIORITY_BOX=priority_4chan.txt"
set "PAUSE_FILE=pause_4chan.txt"
set "STATS_FILE=stats_4chan.txt"
set "FAIL_LOG=failures_4chan.txt"
set MAX_RETRIES=3
set BASE_THREAD_SLEEP=8
set BASE_CYCLE_SLEEP=30
set MIN_THREAD_SLEEP=3
set MAX_THREAD_SLEEP=15
set DRY_RUN=0

:parse_args
if /I "%~1"=="--dry-run" ( set DRY_RUN=1 & shift & goto parse_args )
if /I "%~1"=="--help" goto show_help
if /I "%~1"=="-h" goto show_help
if "%~1"=="/?" goto show_help
if not "%~1"=="" ( shift & goto parse_args )

cls
powershell -Command "Write-Host '===============================================================================' -ForegroundColor Cyan; Write-Host '             4CHAN THREAD MONITOR v2.0' -ForegroundColor Cyan; Write-Host '===============================================================================' -ForegroundColor Cyan"
echo.
if "!DRY_RUN!"=="1" (
    powershell -Command "Write-Host '  [DRY-RUN MODE] No files will be downloaded.' -ForegroundColor Yellow"
    echo.
)

powershell -Command "Write-Host '[STARTUP] Checking gallery-dl...' -ForegroundColor White"
set "GDL_INSTALLED="
where gallery-dl >nul 2>&1
if "!errorlevel!"=="0" (
    for /f "tokens=*" %%V in ('gallery-dl --version 2^>nul') do set "GDL_INSTALLED=%%V"
)
if "!GDL_INSTALLED!"=="" (
    if "!DRY_RUN!"=="1" (
        powershell -Command "Write-Host '[WARN] gallery-dl not found in PATH (continuing in DRY-RUN mode).' -ForegroundColor Yellow"
    ) else (
        powershell -Command "Write-Host '[FATAL] gallery-dl not found. Install from https://github.com/mikf/gallery-dl' -ForegroundColor Red"
        pause & exit /b 1
    )
) else (
    powershell -ExecutionPolicy Bypass -EncodedCommand 
)
echo.

if exist "%LIST%" (
    set "GDL_TARGET=%LIST%"
    powershell -ExecutionPolicy Bypass -EncodedCommand 
    powershell -Command "Write-Host '[STARTUP] Thread list sanitized.' -ForegroundColor Green"
    echo.
)
if exist "%PRIORITY_BOX%" (
    set "GDL_TARGET=%PRIORITY_BOX%"
    powershell -ExecutionPolicy Bypass -EncodedCommand 
    powershell -Command "Write-Host '[STARTUP] Priority list sanitized.' -ForegroundColor Green"
    echo.
)

if not exist "%STATS_FILE%" (
    (
        echo TOTAL_SESSIONS=0
        echo TOTAL_SUCCESS=0
        echo TOTAL_404=0
        echo TOTAL_BLOCKED=0
        echo TOTAL_FAILED=0
        echo TOTAL_UNSUPPORTED=0
    ) > "%STATS_FILE%"
)
set TOTAL_SESSIONS=0 & set TOTAL_SUCCESS=0 & set TOTAL_404=0
set TOTAL_BLOCKED=0  & set TOTAL_FAILED=0 & set TOTAL_UNSUPPORTED=0
for /f "usebackq tokens=1,2 delims==" %%K in ("%STATS_FILE%") do (
    if not "%%K"=="" if not "%%L"=="" set "%%K=%%L"
)
set /a TOTAL_SESSIONS+=0 >nul 2>&1
set /a TOTAL_SUCCESS+=0 >nul 2>&1
set /a TOTAL_404+=0 >nul 2>&1
set /a TOTAL_BLOCKED+=0 >nul 2>&1
set /a TOTAL_FAILED+=0 >nul 2>&1
set /a TOTAL_UNSUPPORTED+=0 >nul 2>&1

powershell -Command "Write-Host 'How many monitor cycles to run? (0 = infinite)' -ForegroundColor White"
set "INPUT=0"
set /p "INPUT=Loop Count: "
set "INPUT=!INPUT:"=!"
set "INPUT=!INPUT: =!"
for /f "delims=0123456789" %%I in ("0!INPUT!") do set "INPUT=0"
set "CLEAN_LOOP=0"
for /f "tokens=* delims=0" %%I in ("0!INPUT!") do set "CLEAN_LOOP=%%I"
set /a MAX_LOOPS=!CLEAN_LOOP! >nul 2>&1
if !MAX_LOOPS! LSS 0 set /a MAX_LOOPS=0 >nul 2>&1
set /a CURRENT_LOOP=0 >nul 2>&1

cls

:loop
if exist "%PAUSE_FILE%" goto do_pause
goto after_pause
:do_pause
powershell -Command "Write-Host '[PAUSED] Delete pause_4chan.txt to resume...' -ForegroundColor Yellow"
:pause_wait
timeout /t 10 >nul
if exist "%PAUSE_FILE%" goto pause_wait
powershell -Command "Write-Host '[RESUMED]' -ForegroundColor Green"
echo.
:after_pause

if exist "%NEW_BOX%" (
    set "GDL_LIST=%LIST%"
    set "GDL_BOX=%NEW_BOX%"
    powershell -ExecutionPolicy Bypass -EncodedCommand 
    echo.
)

set "GDL_TARGET=%LIST%"
set "GDL_TARGET2=%PRIORITY_BOX%"
powershell -ExecutionPolicy Bypass -EncodedCommand 
set "GDL_TARGET2="

set QUEUE_SIZE=0
set PRIO_SIZE=0
if exist "%PRIORITY_BOX%" (
    for /f "usebackq tokens=*" %%C in ("%PRIORITY_BOX%") do (
        if not "%%C"=="" (
            set /a QUEUE_SIZE+=1 >nul 2>&1
            set /a PRIO_SIZE+=1 >nul 2>&1
        )
    )
)
if exist "%LIST%" (
    for /f "usebackq tokens=*" %%C in ("%LIST%") do (
        if not "%%C"=="" (
            set "IS_PRIO_DUP=0"
            if !PRIO_SIZE! GTR 0 (
                findstr /L /I /X /C:"%%C" "%PRIORITY_BOX%" >nul 2>&1 && set "IS_PRIO_DUP=1"
            )
            if "!IS_PRIO_DUP!"=="0" set /a QUEUE_SIZE+=1 >nul 2>&1
        )
    )
)

if !QUEUE_SIZE! EQU 0 (
    powershell -Command "Write-Host '[WAIT] No active threads in queue. Waiting 60s...' -ForegroundColor Yellow"
    timeout /t 60 >nul & cls & goto loop
)

if !MAX_LOOPS! GTR 0 (
    if !CURRENT_LOOP! GEQ !MAX_LOOPS! (
        powershell -Command "Write-Host '[SYSTEM] Max cycles reached. Exiting.' -ForegroundColor Cyan"
        goto end
    )
)

set /a CURRENT_LOOP+=1 >nul 2>&1
if "!DRY_RUN!"=="0" set /a TOTAL_SESSIONS+=1 >nul 2>&1

set THREAD_SLEEP=%BASE_THREAD_SLEEP%
if !QUEUE_SIZE! LEQ 2  set THREAD_SLEEP=%MAX_THREAD_SLEEP%
if !QUEUE_SIZE! GEQ 10 set THREAD_SLEEP=%MIN_THREAD_SLEEP%

powershell -Command "Write-Host '===============================================================================' -ForegroundColor Cyan; Write-Host ' CYCLE: !CURRENT_LOOP!  |  TIME: !TIME:~0,8!  |  QUEUE: !QUEUE_SIZE!  |  SLEEP: !THREAD_SLEEP!s' -ForegroundColor Cyan"
if "!DRY_RUN!"=="1" powershell -Command "Write-Host ' MODE: DRY-RUN' -ForegroundColor Yellow"
powershell -Command "Write-Host '===============================================================================' -ForegroundColor Cyan"
echo.

set CYCLE_SUCCESS=0 & set CYCLE_404=0     & set CYCLE_BLOCKED=0
set CYCLE_FAILED=0  & set CYCLE_SKIPPED=0 & set CYCLE_UNSUPPORTED=0
set CYCLE_ARCHIVED=0

set "DEAD_THIS_CYCLE=dead_cycle_4chan.tmp"
if exist "%DEAD_THIS_CYCLE%" del "%DEAD_THIS_CYCLE%"

if !PRIO_SIZE! GTR 0 (
    powershell -Command "Write-Host '[PRIORITY] Processing priority threads...' -ForegroundColor Yellow"
    echo.
    for /f "usebackq tokens=*" %%P in ("%PRIORITY_BOX%") do (
        if not "%%P"=="" call :process_thread "%%P" "PRIORITY"
    )
    echo.
)

if exist "%LIST%" (
    for /f "usebackq tokens=*" %%A in ("%LIST%") do (
        if not "%%A"=="" call :process_thread "%%A" "NORMAL"
    )
)

set /a CYCLE_DEAD=CYCLE_404+CYCLE_UNSUPPORTED+CYCLE_ARCHIVED >nul 2>&1
if !CYCLE_DEAD! GTR 0 (
    set "GDL_LIST=%LIST%"
    set "GDL_PRIO=%PRIORITY_BOX%"
    set "GDL_DEAD=%DEAD_THIS_CYCLE%"
    powershell -ExecutionPolicy Bypass -EncodedCommand  2>nul
    powershell -Command "Write-Host '[CLEANUP] Removed !CYCLE_DEAD! dead/archived thread(s).' -ForegroundColor Yellow"
    if exist "%DEAD_THIS_CYCLE%" del "%DEAD_THIS_CYCLE%"
)

set /a TOTAL_SUCCESS+=CYCLE_SUCCESS >nul 2>&1
set /a TOTAL_404+=CYCLE_404         >nul 2>&1
set /a TOTAL_BLOCKED+=CYCLE_BLOCKED >nul 2>&1
set /a TOTAL_FAILED+=CYCLE_FAILED       >nul 2>&1
set /a TOTAL_UNSUPPORTED+=CYCLE_UNSUPPORTED >nul 2>&1
if "!DRY_RUN!"=="0" (
    (
        echo TOTAL_SESSIONS=!TOTAL_SESSIONS!
        echo TOTAL_SUCCESS=!TOTAL_SUCCESS!
        echo TOTAL_404=!TOTAL_404!
        echo TOTAL_BLOCKED=!TOTAL_BLOCKED!
        echo TOTAL_FAILED=!TOTAL_FAILED!
        echo TOTAL_UNSUPPORTED=!TOTAL_UNSUPPORTED!
    ) > "%STATS_FILE%"
)

echo.
powershell -Command "Write-Host '-----------------------------------------------------------------------' -ForegroundColor Cyan; Write-Host ' CYCLE !CURRENT_LOOP! SUMMARY' -ForegroundColor Cyan; Write-Host '-----------------------------------------------------------------------' -ForegroundColor Cyan; Write-Host '  Success     : !CYCLE_SUCCESS!'     -ForegroundColor Green; Write-Host '  Archived    : !CYCLE_ARCHIVED!'    -ForegroundColor Cyan; Write-Host '  404d        : !CYCLE_404!'         -ForegroundColor Yellow; Write-Host '  Blocked     : !CYCLE_BLOCKED!'     -ForegroundColor Yellow; Write-Host '  Unsupported : !CYCLE_UNSUPPORTED!' -ForegroundColor Yellow; Write-Host '  Failed      : !CYCLE_FAILED!'      -ForegroundColor Red; Write-Host '  Skipped     : !CYCLE_SKIPPED!'     -ForegroundColor Gray; Write-Host '-----------------------------------------------------------------------' -ForegroundColor Cyan; Write-Host ' ALL-TIME  Sessions:!TOTAL_SESSIONS!  OK:!TOTAL_SUCCESS!  404:!TOTAL_404!  Blocked:!TOTAL_BLOCKED!  Failed:!TOTAL_FAILED!  Unsupported:!TOTAL_UNSUPPORTED!' -ForegroundColor White; Write-Host '-----------------------------------------------------------------------' -ForegroundColor Cyan"
echo.

if !MAX_LOOPS! GTR 0 (
    if !CURRENT_LOOP! GEQ !MAX_LOOPS! (
        powershell -Command "Write-Host '[SYSTEM] Final cycle complete.' -ForegroundColor Cyan"
        goto end
    )
)

set CYCLE_SLEEP=%BASE_CYCLE_SLEEP%
if !QUEUE_SIZE! LEQ 2  set CYCLE_SLEEP=60
if !QUEUE_SIZE! GEQ 10 set CYCLE_SLEEP=15
powershell -Command "Write-Host '[SYSTEM] Resting !CYCLE_SLEEP!s...' -ForegroundColor White"
timeout /t !CYCLE_SLEEP! >nul
cls
goto loop

:process_thread
setlocal
set "T_URL=%~1"
set "T_TYPE=%~2"
set "T_URL=!T_URL:"=!"
set "GDL_URL=!T_URL!"
set "GDL_TYPE=!T_TYPE!"

if /I "!T_TYPE!"=="NORMAL" if !PRIO_SIZE! GTR 0 (
    findstr /L /I /X /C:"!T_URL!" "%PRIORITY_BOX%" >nul 2>&1 && (
        endlocal
        exit /b
    )
)

powershell -Command "Write-Host ('[' + $env:GDL_TYPE + '] Scraping: ' + $env:GDL_URL) -ForegroundColor White"

if "!DRY_RUN!"=="1" (
    powershell -Command "Write-Host ('  [DRY-RUN] gallery-dl --sleep-request 2.0 ' + [char]34 + $env:GDL_URL + [char]34) -ForegroundColor Yellow"
    echo.
    endlocal & set /a CYCLE_SKIPPED+=1 >nul 2>&1
    exit /b
)

set /a RETRY_COUNT=0 >nul 2>&1
:retry_inner
if !RETRY_COUNT! GTR 0 (
    powershell -Command "Write-Host '  [RETRY !RETRY_COUNT!/%MAX_RETRIES%] Waiting 10s...' -ForegroundColor Yellow"
    timeout /t 10 >nul
)

set "GDL_URL=!T_URL!"
set "GDL_LOG=!LOG!"
powershell -ExecutionPolicy Bypass -EncodedCommand 
set DL_ERR=!errorlevel!

if "!DL_ERR!"=="124" (
    >>"%FAIL_LOG%" echo [!DATE! !TIME!] TIMEOUT (600s): !T_URL!
    echo.
    endlocal & set /a CYCLE_FAILED+=1 >nul 2>&1
    exit /b
)

if "!DL_ERR!"=="0" (
    set IS_DEAD_OK=0
    findstr /L /C:"Not Found"   "%LOG%" >nul 2>&1 && set IS_DEAD_OK=1
    findstr /L /C:"has expired" "%LOG%" >nul 2>&1 && set IS_DEAD_OK=1
    findstr /L /C:"is archived" "%LOG%" >nul 2>&1 && set IS_DEAD_OK=1
    if "!IS_DEAD_OK!"=="1" goto handle_404
    set IS_ARCHIVED_FINAL=0
    findstr /L /C:"[ARCHIVED_FINAL]" "%LOG%" >nul 2>&1 && set IS_ARCHIVED_FINAL=1
    if "!IS_ARCHIVED_FINAL!"=="1" (
        >>"%FAIL_LOG%" echo [!DATE! !TIME!] ARCHIVED COMPLETED: !T_URL!
        >>"%DEAD_THIS_CYCLE%" echo(!T_URL!
        powershell -Command "Write-Host '  [OK] Downloaded (archived thread - final pass complete, removing after cycle).' -ForegroundColor Green; Write-Host '  [PAUSE] Waiting !THREAD_SLEEP!s...' -ForegroundColor White"
        echo.
        timeout /t !THREAD_SLEEP! >nul
        endlocal & set /a CYCLE_SUCCESS+=1 >nul 2>&1 & set /a CYCLE_ARCHIVED+=1 >nul 2>&1
        exit /b
    )
    powershell -Command "Write-Host '  [OK] Downloaded.' -ForegroundColor Green; Write-Host '  [PAUSE] Waiting !THREAD_SLEEP!s...' -ForegroundColor White"
    echo.
    timeout /t !THREAD_SLEEP! >nul
    endlocal & set /a CYCLE_SUCCESS+=1 >nul 2>&1
    exit /b
)

set IS_BLOCKED=0 & set IS_404=0 & set IS_UNSUPPORTED=0

findstr /L /I /C:"429 Too Many" /C:"403 Client" /C:"403 Forbidden"                                              "%LOG%" >nul 2>&1 && set IS_BLOCKED=1
findstr /L /I /C:"404 Client" /C:"404 Not Found" /C:"Not Found" /C:"has expired" /C:"is archived" /C:"410 Gone" "%LOG%" >nul 2>&1 && set IS_404=1
findstr /L /I /C:"Unsupported URL" /C:"No suitable extractor"                                                   "%LOG%" >nul 2>&1 && set IS_UNSUPPORTED=1

if "!IS_UNSUPPORTED!"=="1" (
    >>"%FAIL_LOG%" echo [!DATE! !TIME!] UNSUPPORTED: !T_URL!
    >>"%DEAD_THIS_CYCLE%" echo(!T_URL!
    powershell -Command "Write-Host '  [UNSUPPORTED] Not a valid gallery-dl URL. Removing.' -ForegroundColor Yellow"
    echo.
    endlocal & set /a CYCLE_UNSUPPORTED+=1 >nul 2>&1
    exit /b
)

if "!IS_404!"=="1" goto handle_404

if "!IS_BLOCKED!"=="1" (
    >>"%FAIL_LOG%" echo [!DATE! !TIME!] BLOCKED: !T_URL!
    powershell -Command "Write-Host '  [BLOCKED] Cloudflare/rate-limit. Pausing 5 min...' -ForegroundColor Red"
    echo.
    endlocal & set /a CYCLE_BLOCKED+=1 >nul 2>&1
    timeout /t 300 >nul
    exit /b
)

set /a RETRY_COUNT+=1 >nul 2>&1
if !RETRY_COUNT! LEQ %MAX_RETRIES% goto retry_inner

>>"%FAIL_LOG%" echo [!DATE! !TIME!] FAILED (max retries): !T_URL!
powershell -Command "Write-Host '  [FAILED] Exhausted retries. Keeping in queue.' -ForegroundColor Red"
echo.
endlocal & set /a CYCLE_FAILED+=1 >nul 2>&1
exit /b

:handle_404
set "GDL_URL=!T_URL!"
set "GDL_LOG=!LOG!"
powershell -ExecutionPolicy Bypass -EncodedCommand 
if "!errorlevel!"=="0" (
    >>"%FAIL_LOG%" echo [!DATE! !TIME!] ARCHIVE RECOVERED: !T_URL!
    >>"%DEAD_THIS_CYCLE%" echo(!T_URL!
    powershell -Command "Write-Host '  [PAUSE] Waiting !THREAD_SLEEP!s...' -ForegroundColor White"
    echo.
    timeout /t !THREAD_SLEEP! >nul
    endlocal & set /a CYCLE_SUCCESS+=1 >nul 2>&1 & set /a CYCLE_ARCHIVED+=1 >nul 2>&1
    exit /b
)
>>"%FAIL_LOG%" echo [!DATE! !TIME!] 404 REMOVED: !T_URL!
>>"%DEAD_THIS_CYCLE%" echo(!T_URL!
powershell -Command "Write-Host '  [404] Thread gone. Removing after cycle.' -ForegroundColor Yellow"
echo.
endlocal & set /a CYCLE_404+=1 >nul 2>&1
exit /b

:show_help
cls
echo.
echo  4chan Thread Monitor v2.0
echo  -------------------------
echo  USAGE:  4chan-threads-monitor.bat [--dry-run] [--help]
echo.
echo  FILES:
echo    threads_4chan.txt   Thread URLs (one per line)
echo    new_4chan.txt       Drop new URLs here while running
echo    priority_4chan.txt  Scraped first every cycle
echo    pause_4chan.txt     Create to pause, delete to resume
echo    stats_4chan.txt     All-time session stats
echo    failures_4chan.txt  Log of all failures and removals
echo.
pause & exit /b

:end
echo.
powershell -Command "Write-Host '===============================================================================' -ForegroundColor Cyan; Write-Host '  SESSION COMPLETE' -ForegroundColor Cyan; Write-Host '===============================================================================' -ForegroundColor Cyan; Write-Host '  Sessions : !TOTAL_SESSIONS!' -ForegroundColor White; Write-Host '  Success  : !TOTAL_SUCCESS!'  -ForegroundColor Green; Write-Host '  404d     : !TOTAL_404!'      -ForegroundColor Yellow; Write-Host '  Blocked  : !TOTAL_BLOCKED!'  -ForegroundColor Yellow; Write-Host '  Failed      : !TOTAL_FAILED!'       -ForegroundColor Red; Write-Host '  Unsupported : !TOTAL_UNSUPPORTED!'  -ForegroundColor Yellow; Write-Host '===============================================================================' -ForegroundColor Cyan"
powershell -Command "try { [console]::beep(900,200); Start-Sleep -Milliseconds 100; [console]::beep(900,200) } catch {}"
echo.
pause >nul
